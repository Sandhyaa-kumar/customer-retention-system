# Runtime mode
FLASK_ENV=production
FLASK_DEBUG=0
HOST=0.0.0.0
PORT=5000

# Security
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRES=28800

# CORS (comma separated or *)
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# Database
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=3nzK6R3qi2gKQVK.root
DB_PASSWORD=replace-with-your-tidb-generated-password
DB_NAME=test

# Set to 0 to allow API startup even when DB is temporarily unreachable.
REQUIRE_DB_ON_STARTUP=1

# Development only: set to 1 to allow login using ADMIN_USERNAME/ADMIN_PASSWORD
# when the database is unavailable.
ALLOW_LOCAL_FALLBACK_AUTH=0

# Development only: set to 1 to serve customer data from local CSV when DB is unavailable.
ALLOW_LOCAL_DATA_FALLBACK=0

# Default admin bootstrap (change for production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
